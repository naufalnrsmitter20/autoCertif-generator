# ==============================================================================
# AutoCertif — Environment Variable Template
# ==============================================================================

# ------------------------------------------------------------------------------
# Database (Prisma + Supabase PostgreSQL)
# Required for database connectivity and Prisma schema migrations.
# ------------------------------------------------------------------------------
# Transaction-pooled connection string (e.g. Supabase connection pooler on port 6543)
DATABASE_URL="postgresql://postgres:[PASSWORD]@[HOST]:6543/postgres?pgbouncer=true"

# Direct connection string (e.g. Supabase direct connection on port 5432)
DIRECT_URL="postgresql://postgres:[PASSWORD]@[HOST]:5432/postgres"

# Optional helper variable present in repository environment setup
DB_PASSWORD=""

# ------------------------------------------------------------------------------
# Authentication (Auth.js / NextAuth)
# ------------------------------------------------------------------------------
# Secret key for encrypting NextAuth JWT tokens (generate via `openssl rand -base64 32`)
AUTH_SECRET="change-this-to-a-secure-random-32-byte-secret"
# Required in production or custom hosts (e.g. http://localhost:3000)
NEXTAUTH_URL="http://localhost:3000"

# ------------------------------------------------------------------------------
# Admin Provisioning (scripts/provision-admin.ts)
# ------------------------------------------------------------------------------
ADMIN_EMAIL="admin@autocertif.local"
ADMIN_PASSWORD="change-me-in-production-min-12-chars"

# ------------------------------------------------------------------------------
# Future Integration Placeholders
# (Exact variable names will be defined in their respective implementation phases)
# ------------------------------------------------------------------------------
# Phase 4 — Object Storage (Supabase Storage)
# Phase 9 — Background Jobs (Inngest)
